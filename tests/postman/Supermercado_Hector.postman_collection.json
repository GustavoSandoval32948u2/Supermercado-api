{
  "info": {
    "name": "Supermercado Online - Héctor Jesus - Pruebas Funcionales",
    "description": "Colección Postman para evidenciar la parte de UI, Testing y Entrega: health check, Swagger, carrito, simulador de compras, Azure Queue y endpoints principales del supermercado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La API responde 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Swagger JSON",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/swagger/v1/swagger.json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "swagger",
            "v1",
            "swagger.json"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Swagger disponible', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.text()).to.include('Supermercado Online API');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Ver datos de prueba para pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/PedidosQueue/datos-prueba",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "PedidosQueue",
            "datos-prueba"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve datos coherentes de prueba', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.clientes.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Agregar producto al carrito",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Carrito/agregar/1?cantidad=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Carrito",
            "agregar",
            "1"
          ],
          "query": [
            {
              "key": "cantidad",
              "value": "2"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto agregado', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Ver carrito",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Carrito",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Carrito"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Carrito visible', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Confirmar compra del carrito",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Carrito/comprar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Carrito",
            "comprar"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Compra confirmada', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.mensaje).to.include('Compra realizada');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Simular pedido completo con Azure Queue",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ventaId\": 1001,\n  \"clienteNombre\": \"Maria Lopez\",\n  \"emailDestino\": \"cliente.prueba@gmail.com\",\n  \"total\": 89.5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/PedidosQueue/simular-pedido-completo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "PedidosQueue",
            "simular-pedido-completo"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pedido enviado a cola', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.estados.length).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Estado de cola",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/PedidosQueue/estado-cola",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "PedidosQueue",
            "estado-cola"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado de cola consultado', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property('mensajesPendientes');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Crear producto real en API principal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Frijol negro 1 lb\",\n  \"descripcion\": \"Grano basico de supermercado\",\n  \"precio\": 12.5,\n  \"stock\": 40\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Productos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto creado o API principal disponible', function () {",
              "  pm.expect([200,201]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Crear cliente real",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos Ruiz\",\n  \"email\": \"carlos.ruiz@hotmail.com\",\n  \"telefono\": \"5555-2222\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Clientes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cliente creado', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5143",
      "type": "string"
    }
  ]
}