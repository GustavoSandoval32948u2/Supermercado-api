# Configuración de Azure App Service para Supermercado API
# Este archivo documenta todas las variables que hay que configurar en:
# Portal Azure → App Service → supermercado-api-app → Configuration → Application Settings

# ============================================================
# BASE DE DATOS (Azure SQL)
# ============================================================
# Reemplaza la connection string local de Docker
ConnectionStrings__DefaultConnection=Server=supermercado-sqlserver.database.windows.net,1433;Database=SupermercadoDB;User Id=sqladmin;Password=SuperMercado2024!;TrustServerCertificate=False;Encrypt=True;

# ============================================================
# AZURE STORAGE QUEUE (reemplaza Azurite/UseDevelopmentStorage)
# ============================================================
# Copiar desde: Portal → Storage Account → Access Keys → Connection string
AzureStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=supermercadostorage;AccountKey=TU_ACCOUNT_KEY_AQUI;EndpointSuffix=core.windows.net
AzureStorage__QueueName=pedidos-supermercado
# Cambiar a false para que use Azure real y no la cola simulada en memoria
AzureStorage__UseInMemoryQueueWhenUnavailable=false

# ============================================================
# EMAIL (Gmail SMTP — sin cambios respecto al local)
# ============================================================
Email__Remitente=gsandovals@miumg.edu.gt
Email__Password=umer xios vmmk waqk
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587

# ============================================================
# JWT
# ============================================================
Jwt__Key=supermercado-jwt-key-produccion-2024-debe-tener-mas-de-32-chars
Jwt__Issuer=supermercado-api
Jwt__Audience=supermercado-app
Jwt__ExpirationMinutes=60

# ============================================================
# SWAGGER (habilitado en producción para la entrega)
# ============================================================
Swagger__Enabled=true

# ============================================================
# ASPNETCORE
# ============================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80
