{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Error"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=${SQL_SERVER},1433;Database=${SQL_DATABASE};User Id=${SQL_USER};Password=${SA_PASSWORD};TrustServerCertificate=True;"
    },
    "Jwt": {
        "Key": "${JWT_KEY}",
        "Issuer": "supermercado-api",
        "Audience": "supermercado-app",
        "ExpirationMinutes": 60
    }
}
